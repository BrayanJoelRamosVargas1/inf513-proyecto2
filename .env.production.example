# Perfil de PRODUCCION (copiar a .env y completar). No usar .env.example en un servidor real.
APP_NAME="Auxiliares FICCT"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://su-dominio.example
APP_LOCALE=es
APP_FALLBACK_LOCALE=es

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_SEARCH_PATH=public
DB_TIMEZONE=America/La_Paz

# Sesion y cookies seguras (HTTPS obligatorio).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=sync

# Proxy inverso HTTPS: IP(s) del proxy separadas por coma, o * si es el unico acceso al servidor.
TRUSTED_PROXIES=

# Analisis antimalware: obligatorio. Sin ClamAV configurado ninguna decision academica es posible.
FICCT_CLAMSCAN_BINARY=
FICCT_CLAMSCAN_DATABASE=

# El analisis de documentos caduca a las 24 h: debe ejecutarse un planificador cada minuto.
#   Linux:   * * * * * cd /ruta/sistema && php artisan schedule:run >> /dev/null 2>&1
#   Windows: Programador de tareas, cada minuto: php artisan schedule:run
FICCT_EXPERIENCE=training
PORTAL_TELEMETRY_RETENTION_DAYS=90
