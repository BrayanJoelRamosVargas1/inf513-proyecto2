{
  "reason": "No direct or dynamic class token references in own source; old decorative dashboard removed in the preceding design change.",
  "rules": [
    {
      "selector": ".dashboard-hero",
      "css": ".dashboard-hero{position:relative;border-radius:var(--radius);padding:clamp(1.5rem,3vw,2.5rem);\r\n  background:var(--panel);border:1px solid var(--line);margin:0 0 1.35rem;\r\n  display:grid;grid-template-columns:minmax(0,1fr) 15rem;align-items:center;gap:2rem;box-shadow:var(--shadow)}"
    },
    {
      "selector": ".dashboard-hero h1",
      "css": ".dashboard-hero h1{font-size:clamp(1.8rem,3vw,2.8rem);max-width:22ch;margin:.5rem 0 1rem;letter-spacing:-.045em;line-height:1.13}"
    },
    {
      "selector": ".dashboard-hero p",
      "css": ".dashboard-hero p{color:var(--muted);max-width:46rem;margin:0 0 1.3rem;font-size:.94rem}"
    },
    {
      "selector": ".dashboard-hero .eyebrow",
      "css": ".dashboard-hero .eyebrow{color:var(--brand);font-size:.65rem}"
    },
    {
      "selector": ".hero-actions",
      "css": ".hero-actions{display:flex;gap:.65rem;flex-wrap:wrap;position:relative;z-index:1}"
    },
    {
      "selector": ".hero-actions .button",
      "css": ".hero-actions .button{background:var(--brand-solid);color:var(--brand-on);border-color:var(--brand-solid)}"
    },
    {
      "selector": ".hero-actions .secondary",
      "css": ".hero-actions .secondary{background:var(--panel);color:var(--brand);border-color:var(--line)}"
    },
    {
      "selector": ".hero-companion",
      "css": ".hero-companion{display:grid;gap:.7rem;padding:1.5rem;background:var(--accent);border-radius:12px;color:var(--brand);font-size:.75rem}"
    },
    {
      "selector": ".hero-companion strong",
      "css": ".hero-companion strong{font-size:1.5rem;line-height:1.2;letter-spacing:-.04em;color:var(--ink)}"
    },
    {
      "selector": ".hero-companion small",
      "css": ".hero-companion small{color:var(--muted);font-size:.72rem}"
    },
    {
      "selector": ".hero-seal",
      "css": ".hero-seal{display:grid;place-items:center;width:2.7rem;height:2.7rem;background:var(--brand-solid);color:var(--brand-on);border-radius:50%;font-size:1.6rem;font-weight:800}"
    },
    {
      "selector": "[data-contrast=alto] .dashboard-hero",
      "css": "[data-contrast=alto] .dashboard-hero{background:var(--panel);border-width:2px}"
    },
    {
      "selector": ".dashboard-hero",
      "css": ".dashboard-hero{grid-template-columns:minmax(0,1fr)}"
    },
    {
      "selector": ".hero-companion",
      "css": ".hero-companion{display:none}"
    },
    {
      "selector": ".dashboard-hero",
      "css": ".dashboard-hero{padding:1.25rem}"
    }
  ]
}